---
// IntroGreeting.astro - Short, refined editorial greeting ("SO, YOU FOUND ME. / 01 / WELCOME")
---

<div id="intro-greeting" class="intro-greeting-container" aria-hidden="true">
  <div class="intro-greeting-content">
    <div class="intro-brand">
      <span>IF</span><span class="intro-star">✦</span>
    </div>
    <div class="intro-main-text">
      SO, YOU FOUND ME.
    </div>
    <div class="intro-sub-text">
      01 / WELCOME
    </div>
  </div>
</div>

<style>
  .intro-greeting-container {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background-color: var(--bg-editorial, #f3f1e9);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    user-select: none;
    opacity: 1;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .intro-greeting-container.intro-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .intro-greeting-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 1.5rem;
    max-width: 600px;
  }

  .intro-brand {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 800;
    font-size: clamp(18px, 3vw, 24px);
    letter-spacing: -0.02em;
    color: #0a0a0a;
    margin-bottom: 1.25rem;
    opacity: 0;
    transform: translateY(6px);
    animation: introFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  .intro-star {
    display: inline-block;
    font-size: 0.8em;
    vertical-align: top;
    margin-left: 2px;
    margin-top: -2px;
  }

  .intro-main-text {
    font-family: "Space Mono", "Courier Prime", ui-monospace, monospace;
    font-weight: 700;
    font-size: clamp(22px, 4.5vw, 36px);
    line-height: 1.15;
    letter-spacing: 0.02em;
    color: #0a0a0a;
    margin: 0 0 1rem 0;
    opacity: 0;
    transform: translateY(8px);
    animation: introFadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.22s forwards;
  }

  .intro-sub-text {
    font-family: "Space Mono", "Courier Prime", ui-monospace, monospace;
    font-weight: 500;
    font-size: clamp(11px, 2vw, 13.5px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--purple-accent, #6028ff);
    opacity: 0;
    transform: translateY(6px);
    animation: introFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.55s forwards;
  }

  @keyframes introFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const intro = document.getElementById("intro-greeting");
  if (intro) {
    setTimeout(() => {
      intro.classList.add("intro-hidden");
      setTimeout(() => {
        intro.style.display = "none";
      }, 400);
    }, 950);
  }
</script>
