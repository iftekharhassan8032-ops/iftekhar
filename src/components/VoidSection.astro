---
// VoidSection.astro - Section 05 / VOID (Direct Black Transition + Reveal-Masked Particles + Rough Radial Scratch Poster Reveal)
import SectionHeaderHotspots from "./SectionHeaderHotspots.astro";
---

<section
  id="void"
  class="site-section site-section-void overflow-hidden relative bg-[#080808]"
>
  <div class="section-canvas relative bg-[#080808]">
    <SectionHeaderHotspots />

    <!-- 1. Bottom Layer: Hidden Poster Artwork (Clean Full-Resolution Image) -->
    <img
      id="void-image"
      src="/assets/images/void.png"
      alt="05 / VOID"
      class="section-media block relative z-0 select-none"
      loading="eager"
      draggable="false"
    />

    <!-- 2. Middle Layer: Scratchable Dark Shroud Canvas (Rough Radial Erased on Scratch) -->
    <canvas
      id="void-scratch-canvas"
      class="absolute inset-0 w-full h-full pointer-events-none z-10"
    ></canvas>

    <!-- 3. Top Layer: Particles Masked Exclusively Inside Revealed Scratch Areas -->
    <canvas
      id="void-particle-canvas"
      class="absolute inset-0 w-full h-full pointer-events-none z-20"
    ></canvas>
  </div>
</section>

<style>
  #void {
    cursor: crosshair;
    user-select: none;
    -webkit-user-select: none;
  }
</style>

<script>
  interface AmbientParticle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    speed: number;
    wanderAngle: number;
    wanderSpeed: number;
    size: number;
    char: string;
    isDot: boolean;
    color: string;
    alpha: number;
  }

  const voidSection = document.getElementById("void");
  const scratchCanvas = document.getElementById("void-scratch-canvas") as HTMLCanvasElement;
  const particleCanvas = document.getElementById("void-particle-canvas") as HTMLCanvasElement;
  const voidImg = document.getElementById("void-image") as HTMLImageElement;

  if (voidSection && scratchCanvas && particleCanvas && voidImg) {
    const scratchCtx = scratchCanvas.getContext("2d", { willReadFrequently: false });
    const particleCtx = particleCanvas.getContext("2d");

    if (scratchCtx && particleCtx) {
      let dpr = 1;
      let width = 576;
      let height = 1024;
      let isScratching = false;
      let lastPoint: { x: number; y: number } | null = null;

      // Pointer tracking for particle proximity interaction
      const pointer = {
        x: -9999,
        y: -9999,
        active: false,
      };

      // Pre-generated rough, irregular textured radial brush stamps
      let roughBrushes: HTMLCanvasElement[] = [];

      // Playful floating particle system state
      let particles: AmbientParticle[] = [];
      const asciiSymbols = ["•", "·", "✦", "+", "×", "▫", "·", "•"];

      // Generate realistic physical rough brush stamps with irregular notched perimeters
      function generateRoughBrushes() {
        roughBrushes = [];
        const brushSize = 128;
        const center = brushSize / 2;
        const baseR = 48;

        for (let b = 0; b < 6; b++) {
          const bCanvas = document.createElement("canvas");
          bCanvas.width = brushSize;
          bCanvas.height = brushSize;
          const bCtx = bCanvas.getContext("2d");
          if (!bCtx) continue;

          const phase1 = Math.random() * Math.PI * 2;
          const phase2 = Math.random() * Math.PI * 2;
          const phase3 = Math.random() * Math.PI * 2;

          // 1. Build organic irregular radial boundary with harmonic noise & notches
          bCtx.save();
          bCtx.beginPath();
          const segments = 48;
          for (let i = 0; i <= segments; i++) {
            const theta = (i / segments) * Math.PI * 2;
            const distortion =
              0.16 * Math.sin(3 * theta + phase1) +
              0.13 * Math.cos(5 * theta + phase2) +
              0.10 * Math.sin(9 * theta + phase3) +
              (Math.random() - 0.5) * 0.16;

            const r = baseR * Math.max(0.4, 1 + distortion);
            const px = center + Math.cos(theta) * r;
            const py = center + Math.sin(theta) * r;

            if (i === 0) {
              bCtx.moveTo(px, py);
            } else {
              bCtx.lineTo(px, py);
            }
          }
          bCtx.closePath();

          // 2. Soft center with rough radial falloff (~32% accumulation per pass)
          const grad = bCtx.createRadialGradient(center, center, 4, center, center, baseR * 1.15);
          grad.addColorStop(0, "rgba(0, 0, 0, 0.38)");
          grad.addColorStop(0.45, "rgba(0, 0, 0, 0.24)");
          grad.addColorStop(0.75, "rgba(0, 0, 0, 0.09)");
          grad.addColorStop(1, "rgba(0, 0, 0, 0)");

          bCtx.fillStyle = grad;
          bCtx.fill();

          // 3. Add physical micro-notches, gaps & peripheral texture marks
          const notchCount = 14;
          for (let n = 0; n < notchCount; n++) {
            const angle = Math.random() * Math.PI * 2;
            const dist = baseR * (0.65 + Math.random() * 0.42);
            const nx = center + Math.cos(angle) * dist;
            const ny = center + Math.sin(angle) * dist;
            const nr = 2.5 + Math.random() * 4.5;

            const notchGrad = bCtx.createRadialGradient(nx, ny, 0, nx, ny, nr);
            notchGrad.addColorStop(0, "rgba(0, 0, 0, 0.18)");
            notchGrad.addColorStop(1, "rgba(0, 0, 0, 0)");

            bCtx.fillStyle = notchGrad;
            bCtx.beginPath();
            bCtx.arc(nx, ny, nr, 0, Math.PI * 2);
            bCtx.fill();
          }

          bCtx.restore();
          roughBrushes.push(bCanvas);
        }
      }

      function initCanvases() {
        if (!scratchCtx || !particleCtx) return;

        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = scratchCanvas.clientWidth || voidImg.clientWidth || 576;
        height = scratchCanvas.clientHeight || voidImg.clientHeight || 1024;

        generateRoughBrushes();

        // 1. Setup Scratch Canvas with Initial Dark Shroud (Leaving ~5% faint hint)
        scratchCanvas.width = Math.round(width * dpr);
        scratchCanvas.height = Math.round(height * dpr);
        scratchCtx.setTransform(1, 0, 0, 1, 0, 0);
        scratchCtx.scale(dpr, dpr);

        scratchCtx.globalCompositeOperation = "source-over";
        scratchCtx.fillStyle = "rgba(8, 8, 8, 0.95)"; // 95% black shroud, 5% subtle poster hint
        scratchCtx.fillRect(0, 0, width, height);

        // 2. Setup Particle Canvas
        particleCanvas.width = Math.round(width * dpr);
        particleCanvas.height = Math.round(height * dpr);
        particleCtx.setTransform(1, 0, 0, 1, 0, 0);
        particleCtx.scale(dpr, dpr);

        // Initialize playful organic drifting particles with individual wandering velocities
        particles = [];
        const count = Math.round(Math.min(54, Math.max(34, (width * height) / 13000)));

        for (let i = 0; i < count; i++) {
          const isPurple = Math.random() < 0.22;
          const isFaint = Math.random() < 0.50;
          const isDot = Math.random() < 0.50;
          const wanderAngle = Math.random() * Math.PI * 2;
          const speed = 0.20 + Math.random() * 0.35; // Each particle moves at slightly different speeds

          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: Math.cos(wanderAngle) * speed,
            vy: Math.sin(wanderAngle) * speed,
            speed,
            wanderAngle,
            wanderSpeed: 0.04 + Math.random() * 0.05, // Gentle, organic direction variation
            size: isDot ? Math.random() * 1.3 + 1.1 : Math.random() * 2.5 + 8.5,
            char: asciiSymbols[Math.floor(Math.random() * asciiSymbols.length)],
            isDot,
            color: isPurple ? "#6028ff" : isFaint ? "#78746c" : "#dedbd3",
            alpha: isPurple ? 0.75 : isFaint ? 0.45 : 0.7,
          });
        }
      }

      // Stamp rough irregular radial brush with random orientation
      function stampRoughScratch(x: number, y: number) {
        if (!scratchCtx || roughBrushes.length === 0) return;

        const isMobile = window.innerWidth < 768;
        const targetRadius = isMobile
          ? Math.min(42, Math.max(28, width * 0.085))
          : Math.min(58, Math.max(38, width * 0.08));

        const scale = (targetRadius / 48) * (0.88 + Math.random() * 0.24);
        const brush = roughBrushes[Math.floor(Math.random() * roughBrushes.length)];
        const rotation = Math.random() * Math.PI * 2;

        scratchCtx.save();
        scratchCtx.globalCompositeOperation = "destination-out";
        scratchCtx.translate(x, y);
        scratchCtx.rotate(rotation);
        scratchCtx.scale(scale, scale);
        scratchCtx.drawImage(brush, -64, -64);
        scratchCtx.restore();
      }

      // Interpolate continuous rough scratch strokes along mouse/finger path
      function scratchLine(fromX: number, fromY: number, toX: number, toY: number) {
        const dist = Math.hypot(toX - fromX, toY - fromY);
        const stepSize = 7; // Dense overlapping stamps for seamless organic scratching
        const steps = Math.max(1, Math.floor(dist / stepSize));

        for (let i = 0; i <= steps; i++) {
          const t = i / steps;
          const currX = fromX + (toX - fromX) * t;
          const currY = fromY + (toY - fromY) * t;
          stampRoughScratch(currX, currY);
        }
      }

      function updatePointerPos(clientX: number, clientY: number) {
        const rect = particleCanvas.getBoundingClientRect();
        pointer.x = clientX - rect.left;
        pointer.y = clientY - rect.top;
        pointer.active = true;
      }

      function handlePointerStart(clientX: number, clientY: number) {
        updatePointerPos(clientX, clientY);
        isScratching = true;
        lastPoint = { x: pointer.x, y: pointer.y };
        stampRoughScratch(pointer.x, pointer.y);
      }

      function handlePointerMove(clientX: number, clientY: number) {
        updatePointerPos(clientX, clientY);
        if (!isScratching || !lastPoint) return;

        scratchLine(lastPoint.x, lastPoint.y, pointer.x, pointer.y);
        lastPoint = { x: pointer.x, y: pointer.y };
      }

      function handlePointerEnd() {
        isScratching = false;
        lastPoint = null;
      }

      // Desktop Pointer Listeners: Hover moves particles; Drag scratches
      voidSection.addEventListener("pointerenter", (e) => {
        updatePointerPos(e.clientX, e.clientY);
      });

      voidSection.addEventListener("pointermove", (e) => {
        if (isScratching) {
          handlePointerMove(e.clientX, e.clientY);
        } else {
          updatePointerPos(e.clientX, e.clientY);
        }
      });

      voidSection.addEventListener("pointerleave", () => {
        pointer.active = false;
        pointer.x = -9999;
        pointer.y = -9999;
        handlePointerEnd();
      });

      voidSection.addEventListener("mousedown", (e) => {
        if (e.button === 0) {
          handlePointerStart(e.clientX, e.clientY);
        }
      });

      window.addEventListener("mouseup", () => {
        if (isScratching) {
          handlePointerEnd();
        }
      });

      // Mobile Touch Listeners: Touch proximity affects particles + drags scratch
      voidSection.addEventListener(
        "touchstart",
        (e) => {
          if (e.touches.length > 0) {
            const touch = e.touches[0];
            handlePointerStart(touch.clientX, touch.clientY);
          }
        },
        { passive: true },
      );

      voidSection.addEventListener(
        "touchmove",
        (e) => {
          if (e.touches.length > 0) {
            const touch = e.touches[0];
            handlePointerMove(touch.clientX, touch.clientY);
          }
        },
        { passive: true },
      );

      voidSection.addEventListener(
        "touchend",
        () => {
          pointer.active = false;
          pointer.x = -9999;
          pointer.y = -9999;
          handlePointerEnd();
        },
        { passive: true },
      );

      voidSection.addEventListener(
        "touchcancel",
        () => {
          pointer.active = false;
          pointer.x = -9999;
          pointer.y = -9999;
          handlePointerEnd();
        },
        { passive: true },
      );

      // Animation loop: Particles render and are masked exclusively inside revealed regions
      function renderParticles() {
        if (!particleCtx) return;

        particleCtx.clearRect(0, 0, width, height);

        const repulsionRadius = Math.min(85, Math.max(55, width * 0.16));

        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];

          // 1. Playful organic pointer proximity reaction (pushes gently away)
          if (pointer.active) {
            const dx = p.x - pointer.x;
            const dy = p.y - pointer.y;
            const dist = Math.hypot(dx, dy);

            if (dist < repulsionRadius && dist > 0.1) {
              const force = (1 - dist / repulsionRadius) * 1.6;
              p.vx += (dx / dist) * force * 1.3;
              p.vy += (dy / dist) * force * 1.3;
            }
          }

          // 2. Playful organic wandering & soft damping
          p.wanderAngle += (Math.random() - 0.5) * p.wanderSpeed;
          const wanderVx = Math.cos(p.wanderAngle) * p.speed;
          const wanderVy = Math.sin(p.wanderAngle) * p.speed;

          p.vx = p.vx * 0.88 + wanderVx * 0.12;
          p.vy = p.vy * 0.88 + wanderVy * 0.12;

          p.x += p.vx;
          p.y += p.vy;

          // Seamless gentle boundary wrapping
          if (p.x < -10) p.x = width + 10;
          if (p.x > width + 10) p.x = -10;
          if (p.y < -10) p.y = height + 10;
          if (p.y > height + 10) p.y = -10;

          // 3. Render particle
          particleCtx.save();
          particleCtx.globalAlpha = p.alpha;
          particleCtx.fillStyle = p.color;

          if (p.isDot) {
            particleCtx.beginPath();
            particleCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            particleCtx.fill();
          } else {
            particleCtx.font = `${p.size}px monospace, ui-monospace, sans-serif`;
            particleCtx.textAlign = "center";
            particleCtx.textBaseline = "middle";
            particleCtx.fillText(p.char, p.x, p.y);
          }

          particleCtx.restore();
        }

        // 4. MASK PARTICLES SO THEY ONLY APPEAR INSIDE REVEALED / SCRATCHED AREAS
        particleCtx.save();
        particleCtx.globalCompositeOperation = "destination-out";
        particleCtx.drawImage(scratchCanvas, 0, 0, width, height);
        particleCtx.restore();

        requestAnimationFrame(renderParticles);
      }

      // Lifecycle hooks
      if (voidImg.complete) {
        initCanvases();
        renderParticles();
      } else {
        voidImg.addEventListener("load", () => {
          initCanvases();
          renderParticles();
        });
      }

      window.addEventListener("resize", () => {
        initCanvases();
      });
    }
  }
</script>
