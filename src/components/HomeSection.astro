---
// HomeSection.astro - Section 01 / HOME (Full-Width Continuous Section Canvas with Interactive Header Hotspots)
import SectionHeaderHotspots from "./SectionHeaderHotspots.astro";
---

<section id="home" class="site-section">
  <div class="section-canvas relative">
    <SectionHeaderHotspots />
    <video
      id="home-video"
      src="/assets/videos/home.mp4"
      poster="/assets/images/home.webp"
      muted
      playsinline
      preload="metadata"
      width="1024"
      height="1536"
      class="section-media"></video>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const homeSec = document.getElementById("home");
  const vid = document.getElementById("home-video") as HTMLVideoElement;

  if (vid && homeSec) {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (prefersReducedMotion) {
      vid.pause();
    } else {
      let duration = 3.0;
      let targetProgress = 0;
      let currentProgress = 0;
      let isRafRunning = false;
      let lastAppliedTime = -1;

      const setDuration = () => {
        if (vid.duration && !isNaN(vid.duration) && vid.duration > 0) {
          duration = vid.duration;
        }
      };

      vid.addEventListener("loadedmetadata", setDuration);
      vid.addEventListener("canplay", setDuration);
      setDuration();

      vid.pause();

      const applyTime = (time: number) => {
        const safeTime = Math.max(0, Math.min(duration - 0.001, time));
        if (Math.abs(safeTime - lastAppliedTime) >= 0.005) {
          lastAppliedTime = safeTime;
          vid.currentTime = safeTime;
        }
      };

      const updateScrub = () => {
        const diff = targetProgress - currentProgress;

        if (Math.abs(diff) > 0.0004) {
          currentProgress += diff * 0.12;

          if (duration > 0 && !vid.seeking) {
            applyTime(currentProgress * duration);
          }

          requestAnimationFrame(updateScrub);
        } else {
          currentProgress = targetProgress;
          if (duration > 0) {
            applyTime(currentProgress * duration);
          }
          isRafRunning = false;
        }
      };

      vid.addEventListener("seeked", () => {
        if (isRafRunning && duration > 0) {
          applyTime(currentProgress * duration);
        }
      });

      ScrollTrigger.create({
        trigger: homeSec,
        start: "top top",
        end: "bottom 20%",
        onUpdate: (self) => {
          targetProgress = self.progress;
          if (!isRafRunning) {
            isRafRunning = true;
            requestAnimationFrame(updateScrub);
          }
        },
      });
    }
  }
</script>
